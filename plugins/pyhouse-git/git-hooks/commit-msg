#!/bin/sh
# Reject a commit message that is not Conventional Commits 1.0.0.
# https://www.conventionalcommits.org/en/v1.0.0/
#
# Install: /pyhouse-git:install-commit-hook, or by hand, where core.hooksPath is unset and the
# clone's hooks directory (`git rev-parse --git-path hooks`) holds nothing but samples —
#   mkdir -p .githooks && cp this file .githooks/commit-msg && chmod +x .githooks/commit-msg
#   git config core.hooksPath .githooks
# Where a manager's hooks are there (pre-commit, for one), core.hooksPath would silence them: add this
# file to its configuration as a commit-msg hook and install that stage
# (pre-commit install --hook-type commit-msg), or copy it there where no commit-msg hook exists.
#
# Configure (optional):
#   git config pyhouse.commit.types "feat fix docs refactor perf test build ci style chore"
#   git config pyhouse.commit.maxSubject 72
#
# Bypass for one commit: git commit --no-verify

set -e

MSG_FILE="$1"
[ -r "$MSG_FILE" ] || exit 0

# The message as git will store it. Git strips '#' lines only when it cleans up in strip mode, and
# by default that is only when an editor ran: under -m and -F it keeps them, so a '#' line straight
# after the subject lands as the second line. Git tells a hook that no editor ran by setting
# GIT_EDITOR to ':'. Where an editor ran, git cuts the message at the scissors line it writes under
# -v and in scissors mode; scissors mode keeps the '#' lines above it. Leading blank lines go either way.
# A --cleanup given on the command line, and a core.commentChar other than '#', are invisible to a
# hook: set commit.cleanup rather than pass --cleanup, and keep '#'.
EDITED=1
[ "${GIT_EDITOR-}" = ":" ] && EDITED=0
CLEANUP=$(git config --get commit.cleanup || echo default)
if [ "$CLEANUP" = default ]; then
    if [ "$EDITED" = 1 ]; then CLEANUP=strip; else CLEANUP=whitespace; fi
fi
BODY_ALL=$(cat "$MSG_FILE")
if [ "$EDITED" = 1 ]; then
    BODY_ALL=$(printf '%s\n' "$BODY_ALL" | sed '/^# -* >8 -*$/,$d')
fi
if [ "$CLEANUP" = strip ]; then
    BODY_ALL=$(printf '%s\n' "$BODY_ALL" | sed '/^#/d')
fi
BODY_ALL=$(printf '%s\n' "$BODY_ALL" | sed '/[^[:space:]]/,$!d')
SUBJECT=$(printf '%s\n' "$BODY_ALL" | head -n 1)

# Nothing to check: an empty message aborts the commit on its own.
[ -n "$SUBJECT" ] || exit 0

# Git writes these itself, or they are consumed by a later rebase. Not ours to judge.
case "$SUBJECT" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
esac

MAX=$(git config --get pyhouse.commit.maxSubject || echo 72)
TYPES=$(git config --get pyhouse.commit.types || echo "")

fail() {
    printf '\n  commit-msg: %s\n\n' "$1" >&2
    printf '  subject: %s\n\n' "$SUBJECT" >&2
    printf '  Expected: <type>[(scope)][!]: <description>\n' >&2
    printf '    feat(parser): add array support\n' >&2
    printf '    fix: handle an empty payload\n' >&2
    printf '    feat(api)!: return a list where an object was returned\n\n' >&2
    printf '  https://www.conventionalcommits.org/en/v1.0.0/\n' >&2
    printf '  Bypass once with --no-verify.\n\n' >&2
    exit 1
}

# Spec rule 1: type, optional scope, optional !, then a colon and a space.
# Spec rule 4: a scope is parenthesised and non-empty. Spec rule 5: a description follows.
# Spec rule 15: nothing but BREAKING CHANGE is case-sensitive, so a type is accepted in any case.
if ! printf '%s' "$SUBJECT" | grep -qE '^[A-Za-z]+(\([^()]+\))?!?: .+'; then
    case "$SUBJECT" in
        *": "*) fail "the part before the colon is not a valid type or scope" ;;
        *":"*)  fail "a space must follow the colon (spec rule 1)" ;;
        *)      fail "no type — a message begins '<type>: ' (spec rule 1)" ;;
    esac
fi

TYPE=$(printf '%s' "$SUBJECT" | sed -E 's/^([A-Za-z]+).*/\1/')

lower() { printf '%s' "$1" | LC_ALL=C tr 'A-Z' 'a-z'; }

if [ -n "$TYPES" ]; then
    MATCHED=0
    for allowed in $TYPES; do
        [ "$(lower "$allowed")" = "$(lower "$TYPE")" ] && MATCHED=1 && break
    done
    [ "$MATCHED" = 1 ] || fail "type '$TYPE' is not one of: $TYPES"
fi

# Characters, not bytes: drop UTF-8 continuation bytes, so an em dash counts once. Needs no locale.
LEN=$(printf '%s' "$SUBJECT" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' ')
[ "$LEN" -le "$MAX" ] || fail "subject is $LEN characters, limit is $MAX"

# Spec rule 6: a body begins one blank line after the description.
SECOND=$(printf '%s\n' "$BODY_ALL" | sed -n '2p' | tr -d '[:space:]')
if [ -n "$SECOND" ]; then
    fail "a body must be separated from the subject by a blank line (spec rule 6)"
fi

# Spec rules 12 and 15: the footer token is uppercase. Catch the near-misses that parse as prose.
if printf '%s\n' "$BODY_ALL" | grep -qiE '^breaking[ -]change:' \
   && ! printf '%s\n' "$BODY_ALL" | grep -qE '^BREAKING[ -]CHANGE:'; then
    fail "BREAKING CHANGE must be uppercase to be read as a footer (spec rule 15)"
fi

exit 0
